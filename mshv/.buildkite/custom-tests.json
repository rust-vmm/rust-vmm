{
  "tests": [
    {
      "test_name": "build-gnu",
      "command": "cd {crate_path} && RUSTFLAGS=\"-D warnings\" cargo build --release -p mshv-bindings -p mshv-ioctls",
      "platform": [
        "x86_64",
        "aarch64"
      ],
      "timeout_in_minutes": 15,
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "build-musl",
      "command": "cd {crate_path} && RUSTFLAGS=\"-D warnings\" cargo build --release -p mshv-bindings -p mshv-ioctls --target {target_platform}-unknown-linux-musl",
      "platform": [
        "x86_64",
        "aarch64"
      ],
      "timeout_in_minutes": 15,
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "style",
      "command": "cd {crate_path} && cargo fmt -p mshv-bindings -p mshv-ioctls -- --check --config format_code_in_doc_comments=true",
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "unittests-gnu",
      "command": "cd {crate_path} && cargo test --all-features -p mshv-bindings -p mshv-ioctls",
      "platform": [
        "x86_64"
      ],
      "docker_plugin": {
        "privileged": true,
        "devices": ["/dev/mshv"]
      },
      "hypervisor": "mshv",
      "timeout_in_minutes": 15,
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "unittests-musl",
      "command": "cd {crate_path} && cargo test --all-features -p mshv-bindings -p mshv-ioctls --target {target_platform}-unknown-linux-musl",
      "platform": [
        "x86_64"
      ],
      "docker_plugin": {
        "privileged": true,
        "devices": ["/dev/mshv"]
      },
      "hypervisor": "mshv",
      "timeout_in_minutes": 15,
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "clippy",
      "command": "cd {crate_path} && cargo clippy -p mshv-bindings -p mshv-ioctls --bins --examples --benches --all-features --all-targets -- -D warnings",
      "platform": [
        "x86_64",
        "aarch64"
      ],
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "check-warnings",
      "command": "cd {crate_path} && RUSTFLAGS=\"-D warnings\" cargo check --all-targets --all-features -p mshv-bindings -p mshv-ioctls",
      "platform": [
        "x86_64",
        "aarch64"
      ],
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "coverage",
      "command": "ROOT=$$PWD && cd {crate_path} && pytest --test-scope=crate $(find \"$$ROOT\" -path \"*/integration_tests/test_coverage.py\")",
      "docker_plugin": {
        "privileged": true,
        "devices": ["/dev/mshv"]
      },
      "platform": [
        "x86_64"
      ],
      "hypervisor": "mshv",
      "timeout_in_minutes": 15,
      "if_changed": "mshv/*",
      "crate_path": "mshv/mshv-ioctls"
    },
    {
      "test_name": "commit-format",
      "command": "pytest $(find . -type f -name \"test_commit_format.py\")",
      "docker_plugin": {
        "propagate-environment": true
      },
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    },
    {
      "test_name": "cargo-audit",
      "command": "cd {crate_path} && cargo audit -q --deny warnings",
      "if_changed": "mshv/*",
      "crate_path": "mshv"
    }
  ]
}
